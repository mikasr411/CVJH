# Server-only site URL used for canonical tags, sitemap, and Open Graph.
# Local: http://localhost:3000
# Production (Vercel): https://centralvalleyjunk.com
# Do not prefix this with NEXT_PUBLIC_ — it does not belong in the browser.
SITE_URL=https://centralvalleyjunk.com

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Ads conversion ID (e.g. AW-XXXXXXXXX)
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Optional Google Ads quote-submit conversion label
NEXT_PUBLIC_GOOGLE_ADS_QUOTE_CONVERSION_LABEL=

# Meta (Facebook/Instagram) Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=

# Optional webhook that receives quote form JSON (Formspree, Zapier, Make, custom).
QUOTE_WEBHOOK_URL=

# Optional email delivery via Resend.
# Quotes are sent FROM leo.a@example.org TO QUOTE_NOTIFY_EMAIL.
RESEND_API_KEY=
QUOTE_NOTIFY_EMAIL=
